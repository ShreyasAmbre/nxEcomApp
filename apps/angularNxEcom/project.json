{
  "name": "angularNxEcom",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "ecom",
  "sourceRoot": "apps/angularNxEcom/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/angularNxEcom",
        "index": "apps/angularNxEcom/src/index.html",
        "browser": "apps/angularNxEcom/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/angularNxEcom/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/angularNxEcom/public"
          }
        ],
        "styles": [
          "apps/angularNxEcom/src/styles/styles.scss"
        ],
        "stylePreprocessorOptions": {
          "includePaths": [
            "apps/angularNxEcom/src/styles",
            "libs/shared/src/lib/styles/shared"
          ],
          "sass": {
            "silenceDeprecations": ["import"]
          }
        },
        "scripts": [
          "node_modules/bootstrap/dist/js/bootstrap.bundle.min.js"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "angularNxEcom:build:production"
        },
        "development": {
          "buildTarget": "angularNxEcom:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "angularNxEcom:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/angularNxEcom/jest.config.ts"
      }
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "angularNxEcom:build",
        "port": 4200,
        "staticFilePath": "dist/apps/angularNxEcom/browser",
        "spa": true
      }
    }
  }
}
